<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info">

  <targets>
    <!-- Blędy systemu - osobny plik dla każdego dnia -->
    <target name="error_file" 
            xsi:type="File" 
            fileName="${basedir}/../../../logs/error/error-${shortdate}.log"
            layout="${longdate} [${uppercase:${level}}] ${logger} ${message}${onexception:${newline}${exception:format=tostring}}"
            createDirs="true" />

    <!-- Pozostałe informacje (Debug, Info, Warn) - osobny plik dla każdego dnia -->
    <target name="info_file" 
            xsi:type="File" 
            fileName="${basedir}/../../../logs/info/info-${shortdate}.log"
            layout="${longdate} [${uppercase:${level}}] ${logger} ${message}${onexception:${newline}${exception:format=tostring}}"
            createDirs="true" />

    <!-- Console target -->
    <target name="log_console" 
            xsi:type="Console" 
            layout="${longdate} [${uppercase:${level}}] ${logger} ${message}" />
  </targets>

  <rules>
    <!-- Skip non-critical Microsoft logs -->
    <logger name="Microsoft.*" maxLevel="Info" final="true" />

    <!-- Error and Fatal to error file -->
    <logger name="*" minLevel="Error" writeTo="error_file" />

    <!-- Debug, Info, Warn to info file -->
    <logger name="*" maxLevel="Warn" writeTo="info_file" />

    <!-- All to console -->
    <logger name="*" writeTo="log_console" />
  </rules>
</nlog>
