@page "/patients"
@inject IPatientService PatientService
@inject IVisitService VisitService
@inject ISnackbar Snackbar
@inject AppStateService AppState
@inject NavigationManager Nav
@inject ILogger<Patients> Logger
@implements IDisposable

<PageTitle>Patients</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Patients</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="OpenCreateDialog">
        New Patient
    </MudButton>
</MudStack>

<MudDataGrid T="PatientListItemDto"
             Items="_patients"
             Filterable="true"
             SortMode="SortMode.Multiple"
             Hover="true"
             Dense="true"
             Loading="_loading">
    <Columns>
        <PropertyColumn Property="p => p.LastName"  Title="Last Name"  Sortable="true" />
        <PropertyColumn Property="p => p.FirstName" Title="First Name" Sortable="true" />
        <PropertyColumn Property="p => p.Age"       Title="Age"        Sortable="true" />
        <TemplateColumn Title="Last Visit" Sortable="false">
            <CellTemplate>
                @(context.Item.LastVisitDate.HasValue
                    ? context.Item.LastVisitDate.Value.ToString("dd/MM/yyyy")
                    : "No date")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Size="Size.Small"
                               Href="@($"patients/{context.Item.PatientId}")" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>No patients found.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading patients...</MudText>
    </LoadingContent>
</MudDataGrid>

@* Create patient dialog *@
<MudDialog @bind-Visible="_createDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">New Patient</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row="true" Spacing="2">
                <MudTextField @bind-Value="_form.FirstName"  Label="First Name"    Required="true" />
                <MudTextField @bind-Value="_form.LastName"   Label="Last Name"     Required="true" />
            </MudStack>
            <MudTextField @bind-Value="_form.Email"          Label="Email"         Required="true" InputType="InputType.Email" />
            <MudTextField @bind-Value="_form.PhoneNumber"    Label="Phone Number"  Required="true" />
            <MudTextField @bind-Value="_form.Password"       Label="Password"      Required="true" InputType="InputType.Password" />
            <MudTextField @bind-Value="_form.Pesel"          Label="PESEL"         Required="true" />
            <MudTextField @bind-Value="_form.Address"        Label="Address"       Required="true" />
            <MudDatePicker @bind-Date="_formDob"             Label="Date of Birth" Required="true" />
            <MudSelect T="Gender" Label="Gender" @bind-Value="_form.Gender" Required="true">
                <MudSelectItem T="Gender" Value="Gender.Female">Female</MudSelectItem>
                <MudSelectItem T="Gender" Value="Gender.Male">Male</MudSelectItem>
                <MudSelectItem T="Gender" Value="Gender.Other">Other</MudSelectItem>
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCreateDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreatePatient">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PatientListItemDto> _patients = new();
    private bool _loading          = true;
    private bool _createDialogOpen = false;

    private PatientCreateDto _form = new();
    private DateTime?        _formDob = DateTime.Today.AddYears(-30);

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override void OnInitialized()
    {
        if (AppState.CurrentDoctor is null)
        {
            Logger.LogWarning("Patients page access denied. No current doctor in app state.");
            Nav.NavigateTo("/");
            return;
        }
        Logger.LogInformation("Patients page opened for doctor id {DoctorId}.", AppState.CurrentDoctor.DoctorId);
        LoadPatients();
        AppState.OnChange += OnAppStateChanged;
    }

    private void LoadPatients()
    {
        _loading = true;
        Logger.LogDebug("Started loading patients page data.");
        try
        {
            if (AppState.CurrentDoctor is null)
            {
                _patients = PatientService.GetAll();
            }
            else
            {
                // Derive the patient list from this doctor's visits
                var visits = VisitService.GetByDoctorId(AppState.CurrentDoctor.DoctorId);
                var patientIds = visits
                    .Where(v => v.Patient is not null)
                    .Select(v => v.Patient!.PatientId)
                    .Distinct()
                    .ToHashSet();
                _patients = PatientService.GetAll()
                    .Where(p => patientIds.Contains(p.PatientId))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load patients page data.");
            throw;
        }
        _loading = false;
        Logger.LogInformation("Completed loading patients page data. Patients: {PatientCount}", _patients.Count);
    }

    private void OnAppStateChanged()
    {
        Logger.LogDebug("App state changed on patients page. Reloading data.");
        LoadPatients();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChanged;
    }

    private void OpenCreateDialog()
    {
        Logger.LogInformation("Opening create patient dialog.");
        _form    = new PatientCreateDto();
        _formDob = DateTime.Today.AddYears(-30);
        _createDialogOpen = true;
    }

    private void CloseCreateDialog()
    {
        Logger.LogInformation("Closing create patient dialog.");
        _createDialogOpen = false;
    }

    private void CreatePatient()
    {
        _form.DateOfBirth = _formDob ?? DateTime.Today;

        try
        {
            Logger.LogInformation("Started creating patient from BlazorServer UI.");
            PatientService.Create(_form);
            LoadPatients();

            _createDialogOpen = false;
            Logger.LogInformation("Patient created successfully from BlazorServer UI.");
            Snackbar.Add("Patient created successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create patient from BlazorServer UI.");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
