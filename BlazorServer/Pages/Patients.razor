@page "/patients"
@inject IPatientService PatientService
@inject IVisitService VisitService
@inject AppStateService AppState
@inject NavigationManager Nav
@inject ILogger<Patients> Logger
@implements IDisposable

<PageTitle>Patients</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Patients</MudText>
    <MudSpacer />
</MudStack>

<MudDataGrid T="PatientListItemDto"
             Items="_patients"
             Filterable="true"
             SortMode="SortMode.Multiple"
             Hover="true"
             Dense="true"
             Loading="_loading">
    <Columns>
        <TemplateColumn Title="" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudAvatar Size="Size.Medium" Color="Color.Primary">
                    @if (string.IsNullOrWhiteSpace(context.Item.PhotoDataUrl))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                    }
                    else
                    {
                        <MudImage Src="@context.Item.PhotoDataUrl" Alt="Patient photo" ObjectFit="ObjectFit.Cover" />
                    }
                </MudAvatar>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="p => p.LastName"  Title="Last Name"  Sortable="true" />
        <PropertyColumn Property="p => p.FirstName" Title="First Name" Sortable="true" />
        <PropertyColumn Property="p => p.Age"       Title="Age"        Sortable="true" />
        <PropertyColumn Property="p => p.LastVisitDate" Title="Last Visit" Sortable="true">
            <CellTemplate>
                @(context.Item.LastVisitDate.HasValue
                    ? context.Item.LastVisitDate.Value.ToString("dd/MM/yyyy")
                    : "No date")
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Size="Size.Small"
                               Href="@($"patients/{context.Item.PatientId}")" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>No patients found.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading patients...</MudText>
    </LoadingContent>
</MudDataGrid>

@code {
    private List<PatientListItemDto> _patients = new();
    private bool _loading          = true;

    protected override void OnInitialized()
    {
        if (AppState.CurrentDoctor is null)
        {
            Logger.LogWarning("Patients page access denied. No current doctor in app state.");
            Nav.NavigateTo("/");
            return;
        }
        Logger.LogInformation("Patients page opened for doctor id {DoctorId}.", AppState.CurrentDoctor.DoctorId);
        LoadPatients();
        AppState.OnChange += OnAppStateChanged;
    }

    private void LoadPatients()
    {
        _loading = true;
        Logger.LogDebug("Started loading patients page data.");
        try
        {
            if (AppState.CurrentDoctor is null)
            {
                _patients = PatientService.GetAll();
            }
            else
            {
                // Derive the patient list from this doctor's visits
                var visits = VisitService.GetByDoctorId(AppState.CurrentDoctor.DoctorId);
                var patientIds = visits
                    .Where(v => v.Patient is not null)
                    .Select(v => v.Patient!.PatientId)
                    .Distinct()
                    .ToHashSet();
                _patients = PatientService.GetAll()
                    .Where(p => patientIds.Contains(p.PatientId))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load patients page data.");
            throw;
        }
        _loading = false;
        Logger.LogInformation("Completed loading patients page data. Patients: {PatientCount}", _patients.Count);
    }

    private void OnAppStateChanged()
    {
        Logger.LogDebug("App state changed on patients page. Reloading data.");
        LoadPatients();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChanged;
    }
}
