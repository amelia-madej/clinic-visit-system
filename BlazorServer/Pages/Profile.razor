@page "/profile"
@inject IUserService UserService
@inject AppStateService AppState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject ILogger<Profile> Logger

<PageTitle>My Profile</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_user is not null)
{
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4">My Profile</MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        @if (string.IsNullOrWhiteSpace(_user.PhotoDataUrl))
                        {
                            <MudAvatar Size="Size.Large" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                        }
                        else
                        {
                            <img style="width:168px;height:168px;border-radius:50%;object-fit:cover;border:3px solid #d8e2f1;" src="@_user.PhotoDataUrl" alt="Profile photo" />
                        }

                        <label class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-medium mud-ripple profile-upload-button">
                            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" Class="mr-2" />
                            Choose photo
                            <InputFile OnChange="UploadPhoto" accept="image/*" style="display:none" />
                        </label>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Disabled="@string.IsNullOrWhiteSpace(_user.PhotoDataUrl)"
                                   OnClick="RemovePhoto">
                            Remove photo
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4">
                    <EditForm Model="_form" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <MudStack Spacing="3">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_form.FirstName" Label="First name" Required="true" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_form.LastName" Label="Last name" Required="true" />
                                </MudItem>
                            </MudGrid>

                            <MudTextField @bind-Value="_form.Email"
                                          Label="Email"
                                          Required="true"
                                          InputType="InputType.Email" />

                            <MudTextField @bind-Value="_form.PhoneNumber"
                                          Label="Phone number"
                                          Required="true" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       ButtonType="ButtonType.Submit"
                                       Disabled="_saving">
                                Save changes
                            </MudButton>
                        </MudStack>
                    </EditForm>
                </MudPaper>

                <MudPaper Class="pa-4 mt-3">
                    <EditForm Model="_passwordForm" OnValidSubmit="ChangePassword">
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">Change Password</MudText>

                            <MudTextField @bind-Value="_passwordForm.CurrentPassword"
                                          Label="Current password"
                                          Required="true"
                                          InputType="InputType.Password"
                                          Variant="Variant.Outlined" />

                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_passwordForm.NewPassword"
                                                  Label="New password"
                                                  Required="true"
                                                  InputType="InputType.Password"
                                                  Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_passwordForm.ConfirmNewPassword"
                                                  Label="Confirm new password"
                                                  Required="true"
                                                  InputType="InputType.Password"
                                                  Variant="Variant.Outlined" />
                                </MudItem>
                            </MudGrid>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.LockReset"
                                       ButtonType="ButtonType.Submit"
                                       Disabled="_changingPassword">
                                Change password
                            </MudButton>
                        </MudStack>
                    </EditForm>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
}

@code {
    private UserDto? _user;
    private UpdateUserProfileDto _form = new();
    private ChangePasswordForm _passwordForm = new();
    private bool _loading = true;
    private bool _saving;
    private bool _changingPassword;

    protected override void OnInitialized()
    {
        if (AppState.CurrentUser is null)
        {
            Logger.LogWarning("Profile page access denied. No authenticated user in app state.");
            Nav.NavigateTo("/");
            return;
        }

        Logger.LogInformation("Loading profile page for user id {UserId}.", AppState.CurrentUser.UserId);
        LoadUser();
    }

    private void LoadUser()
    {
        Logger.LogDebug("Loading profile data for user id {UserId}.", AppState.CurrentUser?.UserId);
        _user = UserService.GetById(AppState.CurrentUser!.UserId);

        if (_user is not null)
        {
            AppState.RefreshCurrentUser(_user);

            _form = new UpdateUserProfileDto
            {
                UserId = _user.UserId,
                FirstName = _user.FirstName,
                LastName = _user.LastName,
                Email = _user.Email,
                PhoneNumber = _user.PhoneNumber
            };
        }

        _loading = false;
    }

    private void Save()
    {
        _saving = true;
        Logger.LogInformation("Saving profile changes for user id {UserId}.", _form.UserId);

        try
        {
            UserService.UpdateProfile(_form);
            LoadUser();
            Snackbar.Add("Profile updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save profile changes for user id {UserId}.", _form.UserId);
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UploadPhoto(InputFileChangeEventArgs args)
    {
        if (_user is null)
            return;

        var file = args.File;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogWarning("Photo upload rejected for user id {UserId}. Invalid content type: {ContentType}", _user.UserId, file.ContentType);
            Snackbar.Add("Select an image file.", Severity.Error);
            return;
        }

        await using var stream = file.OpenReadStream(1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        try
        {
            Logger.LogInformation("Uploading profile photo for user id {UserId}.", _user.UserId);
            UserService.UpdatePhoto(new UpdateUserPhotoDto
            {
                UserId = _user.UserId,
                PhotoDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}"
            });

            LoadUser();
            Snackbar.Add("Profile photo updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to upload profile photo for user id {UserId}.", _user.UserId);
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void RemovePhoto()
    {
        if (_user is null)
            return;

        try
        {
            Logger.LogInformation("Removing profile photo for user id {UserId}.", _user.UserId);
            UserService.DeletePhoto(_user.UserId);
            LoadUser();
            Snackbar.Add("Profile photo removed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove profile photo for user id {UserId}.", _user.UserId);
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ChangePassword()
    {
        if (AppState.CurrentUser is null)
            return;

        if (_passwordForm.NewPassword.Length < 10)
        {
            Snackbar.Add("Password must contain at least 10 characters.", Severity.Error);
            return;
        }

        if (_passwordForm.NewPassword != _passwordForm.ConfirmNewPassword)
        {
            Snackbar.Add("Passwords must match.", Severity.Error);
            return;
        }

        _changingPassword = true;
        Logger.LogInformation("Changing password for user id {UserId}.", AppState.CurrentUser.UserId);

        try
        {
            UserService.ChangePassword(new ChangePasswordDto
            {
                UserId = AppState.CurrentUser.UserId,
                CurrentPassword = _passwordForm.CurrentPassword,
                NewPassword = _passwordForm.NewPassword
            });

            _passwordForm = new ChangePasswordForm();
            Snackbar.Add("Password changed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to change password for user id {UserId}.", AppState.CurrentUser.UserId);
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _changingPassword = false;
        }
    }

    private sealed class ChangePasswordForm
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
