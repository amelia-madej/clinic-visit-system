@page "/"
@inject IAuthService AuthService
@inject AppStateService AppState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Doctor Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height:100vh;">
    <MudCard Elevation="4" Style="width:100%;">
        <MudCardContent Class="pa-8">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Filled.LocalHospital"
                         Color="Color.Primary"
                         Style="font-size:3rem;" />
                <MudText Typo="Typo.h5">Doctor Portal</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Log in to access visits and patient data
                </MudText>
            </MudStack>

            <EditForm Model="_login" OnValidSubmit="Login">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_login.Email"
                                  Label="Email"
                                  Required="true"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="_login.Password"
                                  Label="Password"
                                  Required="true"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined" />

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <MudAlert Severity="Severity.Error">@_error</MudAlert>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               ButtonType="ButtonType.Submit"
                               Disabled="_loading">
                        Login
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private LoginDto _login = new();
    private bool _loading;
    private string? _error;

    private void Login()
    {
        _loading = true;
        _error = null;

        try
        {
            var result = AuthService.Login(_login);

            if (result.Role != UserRole.Doctor || result.DoctorId is null)
            {
                _error = "This portal is available only for doctors.";
                return;
            }

            AppState.SetUser(result);
            Snackbar.Add($"Welcome, Dr. {result.LastName}.", Severity.Success);
            Nav.NavigateTo("/home");
        }
        catch
        {
            _error = "Invalid doctor email or password.";
        }
        finally
        {
            _loading = false;
        }
    }
}
