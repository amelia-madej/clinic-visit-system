@page "/visits"
@inject IVisitService VisitService
@inject IPatientService PatientService
@inject ISnackbar Snackbar
@inject AppStateService AppState
@inject NavigationManager Nav
@inject ILogger<Visits> Logger
@implements IDisposable

<PageTitle>Visits</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Visits</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        New Visit
    </MudButton>
</MudStack>

<MudDataGrid T="VisitListItemDto"
             Items="_visits"
             Filterable="true"
             SortMode="SortMode.Multiple"
             Hover="true"
             Dense="true"
             Loading="_loading">
    <Columns>
        <PropertyColumn Property="v => v.VisitDateTime" Title="Date & Time" Format="dd/MM/yyyy HH:mm" Sortable="true" />
        <PropertyColumn Property="v => v.Patient!.FullName" Title="Patient" Sortable="true">
            <CellTemplate>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Size="Size.Small" Color="Color.Primary">
                        @if (string.IsNullOrWhiteSpace(context.Item.Patient?.PhotoDataUrl))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        }
                        else
                        {
                            <MudImage Src="@context.Item.Patient.PhotoDataUrl" Alt="Patient photo" ObjectFit="ObjectFit.Cover" />
                        }
                    </MudAvatar>
                    <MudText>@context.Item.Patient?.FirstName @context.Item.Patient?.LastName</MudText>
                </MudStack>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="v => v.Doctor!.FullName" Title="Doctor" Sortable="true">
            <CellTemplate>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Size="Size.Small" Color="Color.Secondary">
                        @if (string.IsNullOrWhiteSpace(context.Item.Doctor?.PhotoDataUrl))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        }
                        else
                        {
                            <MudImage Src="@context.Item.Doctor.PhotoDataUrl" Alt="Doctor photo" ObjectFit="ObjectFit.Cover" />
                        }
                    </MudAvatar>
                    <MudText>@context.Item.Doctor?.FirstName @context.Item.Doctor?.LastName</MudText>
                </MudStack>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="v => v.VisitType" Title="Type" Sortable="true" />
        <PropertyColumn Property="v => v.Status" Title="Status" Sortable="true">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                    @context.Item.Status
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small"
                                   Href="@($"visits/{context.Item.VisitId}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.EditCalendar"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Disabled="@(!CanReschedule(context.Item))"
                                   OnClick="@(() => OpenEditDialog(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   Disabled="@(!CanCancel(context.Item))"
                                   OnClick="@(() => CancelVisit(context.Item))" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>No visits found.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading visits...</MudText>
    </LoadingContent>
</MudDataGrid>

@* Create visit dialog *@
<MudDialog @bind-Visible="_createDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">New Visit</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudSelect T="int?" Label="Patient" @bind-Value="_selectedPatientId" Required="true" Clearable="true">
                @foreach (var p in _patients)
                {
                    <MudSelectItem T="int?" Value="@((int?)p.PatientId)">
                        @p.FirstName @p.LastName
                    </MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker Label="Date" @bind-Date="_formDate" Required="true" />
            <MudTimePicker Label="Time" @bind-Time="_formTime" Required="true" />

            <MudSelect T="string" Label="Visit Type" @bind-Value="_form.VisitType" Required="true">
                <MudSelectItem T="string" Value="@nameof(VisitType.InPerson)">In Person</MudSelectItem>
                <MudSelectItem T="string" Value="@nameof(VisitType.Telemedicine)">Telemedicine</MudSelectItem>
                <MudSelectItem T="string" Value="@nameof(VisitType.HomeVisit)">Home Visit</MudSelectItem>
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseCreateDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateVisit">Create</MudButton>
    </DialogActions>
</MudDialog>

@* Edit visit date dialog *@
<MudDialog @bind-Visible="_editDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Visit Date</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudDatePicker Label="Date" @bind-Date="_editDate" Required="true" />
            <MudTimePicker Label="Time" @bind-Time="_editTime" Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseEditDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveVisitDate">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<VisitListItemDto>     _visits   = new();
    private List<PatientListItemDto>   _patients = new();
    private bool _loading           = true;
    private bool _createDialogOpen  = false;
    private bool _editDialogOpen    = false;

    private VisitCreateDto _form     = new();
    private int?           _selectedPatientId;
    private DateTime?      _formDate = DateTime.Today;
    private TimeSpan?      _formTime = new TimeSpan(8, 0, 0);
    private VisitListItemDto? _editingVisit;
    private DateTime?      _editDate;
    private TimeSpan?      _editTime;

    private readonly DialogOptions _dialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    protected override void OnInitialized()
    {
        if (AppState.CurrentDoctor is null)
        {
            Logger.LogWarning("Visits page access denied. No current doctor in app state.");
            Nav.NavigateTo("/");
            return;
        }
        Logger.LogInformation("Visits page opened for doctor id {DoctorId}.", AppState.CurrentDoctor.DoctorId);
        try
        {
            Logger.LogDebug("Started loading visit form lookup data.");
            _patients = PatientService.GetAll();
            Logger.LogDebug("Completed loading visit form lookup data. Patients: {PatientCount}", _patients.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load visit form lookup data.");
            throw;
        }
        LoadVisits();
        AppState.OnChange += OnAppStateChanged;
    }

    private void LoadVisits()
    {
        _loading = true;
        Logger.LogDebug("Started loading visits page data.");
        try
        {
            _visits  = AppState.CurrentDoctor is null
                ? VisitService.GetAll()
                : VisitService.GetByDoctorId(AppState.CurrentDoctor.DoctorId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load visits page data.");
            throw;
        }
        _loading = false;
        Logger.LogInformation("Completed loading visits page data. Visits: {VisitCount}", _visits.Count);
    }

    private void OnAppStateChanged()
    {
        Logger.LogDebug("App state changed on visits page. Reloading data.");
        LoadVisits();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChanged;
    }

    private void OpenCreateDialog()
    {
        Logger.LogInformation("Opening create visit dialog.");
        _form     = new VisitCreateDto();
        _selectedPatientId = null;
        _formDate = DateTime.Today;
        _formTime = new TimeSpan(8, 0, 0);
        _createDialogOpen = true;
    }

    private void CloseCreateDialog()
    {
        Logger.LogInformation("Closing create visit dialog.");
        _createDialogOpen = false;
    }

    private void CreateVisit()
    {
        if (AppState.CurrentDoctor is null)
            return;

        if (_selectedPatientId is null)
        {
            Snackbar.Add("Select a patient.", Severity.Error);
            return;
        }

        _form.PatientId = _selectedPatientId.Value;
        _form.DoctorId = AppState.CurrentDoctor.DoctorId;
        _form.VisitDateTime = (_formDate ?? DateTime.Today) + (_formTime ?? TimeSpan.Zero);

        try
        {
            Logger.LogInformation("Started creating visit from BlazorServer UI.");
            VisitService.Create(_form);
            LoadVisits();

            _createDialogOpen = false;
            Logger.LogInformation("Visit created successfully from BlazorServer UI.");
            Snackbar.Add("Visit created successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create visit from BlazorServer UI.");
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OpenEditDialog(VisitListItemDto visit)
    {
        if (!CanReschedule(visit))
            return;

        _editingVisit = visit;
        _editDate = visit.VisitDateTime.Date;
        _editTime = visit.VisitDateTime.TimeOfDay;
        _editDialogOpen = true;
    }

    private void CloseEditDialog()
    {
        _editDialogOpen = false;
        _editingVisit = null;
    }

    private void SaveVisitDate()
    {
        if (_editingVisit?.Patient is null || _editingVisit.Doctor is null)
            return;

        var dto = new VisitUpdateDto
        {
            VisitId = _editingVisit.VisitId,
            PatientId = _editingVisit.Patient.PatientId,
            DoctorId = AppState.CurrentDoctor?.DoctorId ?? _editingVisit.Doctor.DoctorId,
            VisitDateTime = (_editDate ?? DateTime.Today) + (_editTime ?? TimeSpan.Zero),
            VisitType = _editingVisit.VisitType,
            Status = _editingVisit.Status
        };

        try
        {
            Logger.LogInformation("Updating visit date for visit id {VisitId}.", dto.VisitId);
            VisitService.Update(dto);
            CloseEditDialog();
            LoadVisits();
            Snackbar.Add("Visit date updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update visit date for visit id {VisitId}.", dto.VisitId);
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelVisit(VisitListItemDto visit)
    {
        if (!CanCancel(visit) || visit.Patient is null || visit.Doctor is null)
            return;

        var dto = new VisitUpdateDto
        {
            VisitId = visit.VisitId,
            PatientId = visit.Patient.PatientId,
            DoctorId = AppState.CurrentDoctor?.DoctorId ?? visit.Doctor.DoctorId,
            VisitDateTime = visit.VisitDateTime,
            VisitType = visit.VisitType,
            Status = nameof(VisitStatus.Cancelled)
        };

        try
        {
            Logger.LogInformation("Cancelling visit id {VisitId}.", dto.VisitId);
            VisitService.Update(dto);
            LoadVisits();
            Snackbar.Add("Visit cancelled.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel visit id {VisitId}.", dto.VisitId);
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private bool CanCancel(VisitListItemDto visit) => visit.Status == nameof(VisitStatus.Scheduled);

    private bool CanReschedule(VisitListItemDto visit) =>
        visit.Status == nameof(VisitStatus.Scheduled) && visit.VisitDateTime >= DateTime.Now.AddMinutes(-5);

    private Color StatusColor(string status) => status switch
    {
        "Scheduled" => Color.Info,
        "Completed" => Color.Success,
        "Cancelled" => Color.Error,
        _           => Color.Default
    };
}
