@inherits LayoutComponentBase
@inject IDoctorService DoctorService
@inject AppStateService AppState
@inject NavigationManager Nav
@inject ILogger<MainLayout> Logger
@implements IDisposable

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">Doctor Portal</MudText>
        <MudSpacer />
        @if (AppState.CurrentUser is { } currentUser)
        {
            @if (string.IsNullOrWhiteSpace(currentUser.PhotoDataUrl))
            {
                <MudAvatar Size="Size.Small" Color="Color.Inherit" Class="mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                </MudAvatar>
            }
            else
            {
                <MudAvatar Size="Size.Small" Class="mr-2">
                    <MudImage Src="@currentUser.PhotoDataUrl" Alt="Profile photo" ObjectFit="ObjectFit.Cover" />
                </MudAvatar>
            }

            <MudText Typo="Typo.body1" Class="mr-2">
                @(currentUser.Role == UserRole.Doctor ? "Dr. " : "")@currentUser.FirstName @currentUser.LastName
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                           Color="Color.Inherit"
                           OnClick="Switch" />
        }
    </MudAppBar>

    @if (AppState.CurrentUser is not null)
    {
        <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">Menu</MudText>
            </MudDrawerHeader>
            <NavMenu />
        </MudDrawer>
    }

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        RedirectIfLoggedOut();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            RedirectIfLoggedOut();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        RedirectIfLoggedOut();
    }

    private void RedirectIfLoggedOut()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        var isLoginPage = string.IsNullOrWhiteSpace(relativePath);

        if (!isLoginPage && AppState.CurrentUser is null)
        {
            Logger.LogInformation("Blocked navigation to '{Path}' for logged-out user.", relativePath);
            Nav.NavigateTo("/", replace: true);
        }
    }

    private void ToggleDrawer()
    {
        if (AppState.CurrentUser is null)
            return;

        _drawerOpen = !_drawerOpen;
    }

    private void Switch()
    {
        Logger.LogInformation("User requested logout.");
        AppState.Logout();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary          = "#2E7D32",
            PrimaryDarken    = "#1B5E20",
            PrimaryLighten   = "#4CAF50",
            Secondary        = "#81C784",
            AppbarBackground = "#2E7D32",
            DrawerBackground = "#F1F8E9",
            DrawerText       = "#1B5E20",
            DrawerIcon       = "#2E7D32",
        }
    };
}
