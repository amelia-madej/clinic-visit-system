@inherits LayoutComponentBase
@inject AppStateService AppState
@inject NavigationManager Nav
@inject NotificationService NotificationService

<RadzenLayout Style="height:100vh">
    <RadzenNotification />
    <!-- HEADER -->
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Style="width:100%; padding:10px; background-color:#0b2545; color:white;">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="10px">

                <RadzenButton Icon="menu"
                              Size="ButtonSize.Small"
                              Click="@ToggleSidebar"
                              class="menu-btn" />

                <RadzenText Text="Patient Portal"
                            TextStyle="TextStyle.Subtitle1"
                            Style="color:white;" />

            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="10px">

                @if (AppState.CurrentPatient is not null)
                {
                    <RadzenText Text="@($"{AppState.CurrentPatient.FirstName} {AppState.CurrentPatient.LastName}")"
                                Style="color:white;" />

                    <RadzenButton Icon="logout"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@Switch" />
                }

            </RadzenStack>

        </RadzenStack>
    </RadzenHeader>

    <!-- SIDEBAR -->
    <RadzenSidebar @bind-Expanded="_sidebarOpen"
                   Style="background-color: var(--rz-primary-light); color:white;">

        <NavMenu />

    </RadzenSidebar>

    <!-- BODY -->
    <RadzenBody Style="background-color:white; padding:20px;">
        @Body
    </RadzenBody>

</RadzenLayout>

@code {
    private bool _sidebarOpen = false;

    private void ToggleSidebar()
    {
        if (AppState.CurrentPatient is null)
            return;

        _sidebarOpen = !_sidebarOpen;
    }

    private void Switch()
    {
        AppState.SetPatient(null);
        Nav.NavigateTo("/");
    }
}