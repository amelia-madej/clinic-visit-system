@inherits LayoutComponentBase
@inject AppStateService AppState
@inject NavigationManager Nav
@inject NotificationService NotificationService
@implements IDisposable

<RadzenLayout Style="height:100vh">
    <RadzenNotification />
    <!-- HEADER -->
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Style="width:100%; padding:10px; background-color:#0b2545; color:white;">

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="10px">

                <RadzenButton Icon="menu"
                              Size="ButtonSize.Small"
                              Click="@ToggleSidebar"
                              class="menu-btn" />

                <RadzenText Text="Patient Portal"
                            TextStyle="TextStyle.Subtitle1"
                            Style="color:white;" />

            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="10px">

                @if (AppState.CurrentPatient is not null)
                {
                    @if (string.IsNullOrWhiteSpace(AppState.CurrentUser?.PhotoDataUrl))
                    {
                        <div style="width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eef3fa;color:#0b2545;border:2px solid rgba(255,255,255,.65);">
                            <RadzenIcon Icon="person" Style="font-size:20px;" />
                        </div>
                    }
                    else
                    {
                        <img src="@AppState.CurrentUser.PhotoDataUrl"
                             alt="Profile photo"
                             style="width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.85);" />
                    }

                    <RadzenText Text="@($"{AppState.CurrentPatient.FirstName} {AppState.CurrentPatient.LastName}")"
                                Style="color:white;" />

                    <RadzenButton Icon="logout"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@Switch"
                                  class="menu-btn" />
                }

            </RadzenStack>

        </RadzenStack>
    </RadzenHeader>

    <!-- SIDEBAR -->
    @if (AppState.CurrentUser is not null)
    {
        <RadzenSidebar @bind-Expanded="_sidebarOpen"
                       Style="background-color: var(--rz-primary-light); color:white;">

            <NavMenu />

        </RadzenSidebar>
    }

    <!-- BODY -->
    <RadzenBody Style="background-color:white; padding:20px;">
        @Body
    </RadzenBody>

</RadzenLayout>

@code {
    private bool _sidebarOpen = false;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        RedirectIfLoggedOut();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            RedirectIfLoggedOut();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        RedirectIfLoggedOut();
    }

    private void RedirectIfLoggedOut()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        var isLoginPage = string.IsNullOrWhiteSpace(relativePath);

        if (!isLoginPage && AppState.CurrentUser is null)
            Nav.NavigateTo("/", replace: true);
    }

    private void ToggleSidebar()
    {
        if (AppState.CurrentUser is null)
            return;

        _sidebarOpen = !_sidebarOpen;
    }

    private void Switch()
    {
        AppState.Logout();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
