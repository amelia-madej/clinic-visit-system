@page "/"
@inject HttpClient Http
@inject AppStateService AppState
@inject NavigationManager Nav

<PageTitle>Patient Portal</PageTitle>

<RadzenStack AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.Center"
             Style="min-height:100vh; background: var(--rz-base-background-color);">

    <RadzenCard Style="width:420px; padding:32px; border-radius:16px;">

        <!-- HEADER -->
        <RadzenStack AlignItems="AlignItems.Center"
                     Gap="10px"
                     Style="margin-bottom:24px;">

            <RadzenIcon Icon="person"
                        Style="font-size:56px; color: var(--rz-primary);" />

            <RadzenText Text="Patient Portal"
                        TextStyle="TextStyle.H4"                                    
                        Style="color: var(--rz-primary-dark); margin:0; font-weight:600;" />

            <RadzenText Text="Select your profile to continue"
                        Style="color:gray;" />

        </RadzenStack>

        <!-- DROPDOWN -->
        <RadzenDropDown Data="@_patients"
                        TValue="int?"
                        @bind-Value="_selectedPatientId"
                        TextProperty="FullName"
                        ValueProperty="PatientId"
                        Placeholder="Select Patient"
                        Style="width:100%; margin-bottom:20px;" />

        <!-- BUTTON -->
        <RadzenButton Text="Continue"
                      Icon="login"
                      Click="@Continue"
                      Disabled="@(_selectedPatientId is null)"
                      ButtonStyle="ButtonStyle.Primary"
                      Style="width:100%; height:42px;" />

    </RadzenCard>

</RadzenStack>

@code {

    private List<PatientListItemDto> _patients = new();
    private int? _selectedPatientId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _patients = await Http.GetFromJsonAsync<List<PatientListItemDto>>("api/Patient")
                         ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($">>> BŁĄD: {ex.Message}");
        }
    }

    private void Continue()
    {
        if (_selectedPatientId is null)
            return;

        var patient = _patients.FirstOrDefault(p => p.PatientId == _selectedPatientId);

        if (patient is null)
            return;

        AppState.SetPatient(patient);
        Nav.NavigateTo("/patient/visits");
    }
}